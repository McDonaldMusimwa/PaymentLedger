# Copy to apps/ledger-api/.env (gitignored) and fill in. docker-compose loads it for ledger-api.

# Invoice files in Cloudflare R2, stored as <STORAGE_PREFIX>/<org_id>/invoices/<invoice_id>.pdf.
# Leave the keys empty to keep files on local disk instead.
S3_API_URL=https://<cloudflare_account_id>.r2.cloudflarestorage.com
S3_BUCKET=
ACCESS_KEY=
SECRET_KEY=
STORAGE_PREFIX=payment-ledger

# Invoice extraction. OpenRouter's free models read the PDF's text layer: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Comma-separated, tried in order.
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
# Optional: Claude, which can also read scanned PDFs.
ANTHROPIC_API_KEY=
