# Copy to .env. Defaults work for local development.
POSTGRES_PASSWORD=postgres
AUTH_DB_PASSWORD=auth
LEDGER_DB_PASSWORD=ledger
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Production: set a fixed Ed25519 PKCS#8 PEM (\n-escaped). Unset = generated and kept in a volume.
JWT_PRIVATE_KEY=
# ledger-api secrets (R2, OpenRouter, Anthropic) go in apps/ledger-api/.env; see apps/ledger-api/.env.example.
# Shared secret between settlement-service and ledger-api. Change outside local dev.
INTERNAL_API_TOKEN=dev-internal-token
# /demo endpoints: seed data and simulated (non-onchain) settlement.
ENABLE_DEMO=true
